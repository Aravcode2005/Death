<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%=pageTitle%></title>
<link href="/css/scene.css" rel="stylesheet"/>
</head>
<body>
  <div class="page-shell">
    <header class="navbar">
      <div class="brand">Sea of Echoes</div>
      <div class="status-badge">Abyssal Wave</div>
    </header>
    <section class="canvas-shell">
      <div class="canvas-overlay"></div>
      <canvas id="gameCanvas">gameCanvas</canvas>
      <div class="info-block">
        <p><strong>Sea Mode:</strong> Discover drifting relics and glowing currents.</p>
      </div>
    </section>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <script src="/players.js"></script>
</body>
</html>
