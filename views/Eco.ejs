<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%=pageTitle%></title>
  <link href="/css/scene.css" rel="stylesheet"/>
</head>
<body>
  <div class="page-shell">
    <section class="hero panel glow-panel">
      <div class="logo">Echoes of Oblivion</div>
      <p class="tagline">A neo-fantasy adventure wrapped in anime glow: uncover ancient ruins, command spectral forces, and shape your destiny.</p>
      <div class="hero-buttons">
        <button class="btn btn-primary" type="button" onclick="location.href='/signin'">Sign In</button>
        <button class="btn btn-secondary" type="button" onclick="location.href='/signup'">Sign Up</button>
        <button class="btn btn-ghost" type="button" onclick="location.href='/mainScene'">Enter the Realm</button>
      </div>
      <div class="hero-details">
        <div class="detail-card">
          <span>✦</span>
          <p>Immersive world-building</p>
        </div>
        <div class="detail-card">
          <span>⚔️</span>
          <p>Battle the unknown</p>
        </div>
        <div class="detail-card">
          <span>🌊</span>
          <p>Explore lost landscapes</p>
        </div>
      </div>
      <p class="footer-note">Start your expedition with a polished, cinematic interface built for the story.</p>
    </section>
  </div>
</body>
</html>
